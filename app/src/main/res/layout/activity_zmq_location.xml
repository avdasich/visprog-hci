<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ZMQ + Геолокация"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/etServerIp"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="IP сервера (10.0.2.2)"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FFFFFF"
        android:inputType="text"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="140dp"
        android:layout_height="55dp"
        android:text="Старт"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#43A047"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/etServerIp"
        app:layout_constraintEnd_toStartOf="@id/btnStop"/>

    <Button
        android:id="@+id/btnStop"
        android:layout_width="140dp"
        android:layout_height="55dp"
        android:text="Стоп"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E53935"
        android:layout_marginTop="20dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/etServerIp"
        app:layout_constraintStart_toEndOf="@id/btnStart"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardLocation"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:cardBackgroundColor="#2C2C2C"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/btnStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Координаты"
                android:textColor="#8E24AA"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvLat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Широта: —"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvLon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Долгота: —"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/tvAlt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Высота: —"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="6dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvLog"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:text="Введите IP и нажмите Старт"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="200dp"
        android:layout_height="55dp"
        android:text="Назад"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#455A64"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>